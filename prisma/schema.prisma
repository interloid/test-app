generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Keep the provider, remove the url line completely
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}